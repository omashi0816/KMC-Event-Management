@model KMCEventClient.Models.RegisterRequest

@{
    ViewData["Title"] = "Register";
}

<style>
    .register-page {
        min-height: 75vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px 15px;
    }

    .register-container {
        width: 100%;
        max-width: 950px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        background: white;
        border-radius: 25px;
        overflow: hidden;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.12);
    }

    /* Left Side */
    .register-welcome {
        background: linear-gradient(135deg, #0d6efd, #6610f2);
        color: white;
        padding: 55px 45px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .register-logo {
        font-size: 55px;
        margin-bottom: 20px;
    }

    .register-welcome h1 {
        font-size: 2.6rem;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .register-welcome p {
        font-size: 1.05rem;
        line-height: 1.7;
        opacity: 0.9;
    }

    .register-features {
        margin-top: 25px;
        padding: 0;
        list-style: none;
    }

    .register-features li {
        margin-bottom: 14px;
        font-size: 0.95rem;
    }

    /* Right Side */
    .register-form-section {
        padding: 55px 45px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .register-form-section h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #212529;
        margin-bottom: 8px;
    }

    .register-subtitle {
        color: #6c757d;
        margin-bottom: 30px;
    }

    .form-label {
        font-weight: 600;
        color: #343a40;
    }

    .form-control {
        height: 48px;
        border-radius: 12px;
        border: 1px solid #dee2e6;
        padding: 10px 15px;
        transition: 0.2s;
    }

    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.12);
    }

    .register-button {
        width: 100%;
        height: 48px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(135deg, #0d6efd, #6610f2);
        color: white;
        font-weight: 600;
        font-size: 1rem;
        transition: 0.3s;
    }

    .register-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(13, 110, 253, 0.25);
        color: white;
    }

    .login-section {
        text-align: center;
        margin-top: 22px;
        color: #6c757d;
    }

    .login-link {
        color: #0d6efd;
        font-weight: 600;
        text-decoration: none;
    }

    .login-link:hover {
        text-decoration: underline;
    }

    .validation-summary {
        border-radius: 10px;
        margin-bottom: 20px;
    }

    @@media (max-width: 768px) {

        .register-container {
            grid-template-columns: 1fr;
        }

        .register-welcome {
            padding: 40px 30px;
            text-align: center;
        }

        .register-welcome h1 {
            font-size: 2.1rem;
        }

        .register-form-section {
            padding: 40px 30px;
        }

        .register-features {
            display: none;
        }
    }
</style>


<div class="register-page">

    <div class="register-container">

        <!-- Welcome Section -->
        <div class="register-welcome">

            <div class="register-logo">
                🎫
            </div>

            <h1>Join KMC Events</h1>

            <p>
                Create your account and start managing
                events, participants and registrations easily.
            </p>

            <ul class="register-features">

                <li>📅 Discover and manage events</li>

                <li>👥 Manage participants</li>

                <li>📝 Handle event registrations</li>

                <li>⚡ Simple and efficient event management</li>

            </ul>

        </div>


        <!-- Registration Form -->
        <div class="register-form-section">

            <h2>Create Account</h2>

            <p class="register-subtitle">
                Fill in your details to create a new account.
            </p>


            <form asp-action="Register" method="post">

                @Html.AntiForgeryToken()

                @Html.ValidationSummary(
                    true,
                    "",
                    new { @class = "text-danger validation-summary" }
                )


                <!-- Name -->
                <div class="mb-3">

                    <label asp-for="Name" class="form-label">
                        Full Name
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Enter your full name" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>


                <!-- Email -->
                <div class="mb-3">

                    <label asp-for="Email" class="form-label">
                        Email Address
                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Enter your email" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>


                <!-- Password -->
                <div class="mb-4">

                    <label asp-for="Password" class="form-label">
                        Password
                    </label>

                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           placeholder="Create a password" />

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>

                </div>


                <!-- Register Button -->
                <button type="submit"
                        class="register-button">
                    ✨ Create Account
                </button>


                <!-- Login Link -->
                <div class="login-section">

                    Already have an account?

                    <a class="login-link"
                       asp-action="Login">
                        Back to Login
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}