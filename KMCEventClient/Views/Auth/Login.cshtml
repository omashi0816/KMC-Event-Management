@model KMCEventClient.Models.LoginRequest

@{
    ViewData["Title"] = "Login";
}

<style>
    .login-page {
        min-height: 75vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px 15px;
    }

    .login-container {
        width: 100%;
        max-width: 950px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        background: white;
        border-radius: 25px;
        overflow: hidden;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.12);
    }

    /* Left Side */
    .login-welcome {
        background: linear-gradient(135deg, #0d6efd, #6610f2);
        color: white;
        padding: 55px 45px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .login-logo {
        font-size: 55px;
        margin-bottom: 20px;
    }

    .login-welcome h1 {
        font-size: 2.6rem;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .login-welcome p {
        font-size: 1.05rem;
        line-height: 1.7;
        opacity: 0.9;
    }

    .login-features {
        margin-top: 25px;
        padding: 0;
        list-style: none;
    }

    .login-features li {
        margin-bottom: 14px;
        font-size: 0.95rem;
    }

    /* Right Side */
    .login-form-section {
        padding: 55px 45px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .login-form-section h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #212529;
        margin-bottom: 8px;
    }

    .login-subtitle {
        color: #6c757d;
        margin-bottom: 30px;
    }

    .form-label {
        font-weight: 600;
        color: #343a40;
    }

    .form-control {
        height: 48px;
        border-radius: 12px;
        border: 1px solid #dee2e6;
        padding: 10px 15px;
        transition: 0.2s;
    }

    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.12);
    }

    .login-button {
        width: 100%;
        height: 48px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(135deg, #0d6efd, #6610f2);
        color: white;
        font-weight: 600;
        font-size: 1rem;
        transition: 0.3s;
    }

    .login-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(13, 110, 253, 0.25);
        color: white;
    }

    .register-section {
        text-align: center;
        margin-top: 22px;
        color: #6c757d;
    }

    .register-link {
        color: #0d6efd;
        font-weight: 600;
        text-decoration: none;
    }

    .register-link:hover {
        text-decoration: underline;
    }

    .validation-summary {
        border-radius: 10px;
        margin-bottom: 20px;
    }

    @@media (max-width: 768px) {
        .login-container {
            grid-template-columns: 1fr;
        }

        .login-welcome {
            padding: 40px 30px;
            text-align: center;
        }

        .login-welcome h1 {
            font-size: 2.1rem;
        }

        .login-form-section {
            padding: 40px 30px;
        }

        .login-features {
            display: none;
        }
    }
</style>


<div class="login-page">

    <div class="login-container">

        <!-- Welcome Section -->
        <div class="login-welcome">

            <div class="login-logo">
                🎫
            </div>

            <h1>Welcome Back!</h1>

            <p>
                Sign in to your KMC Event account and manage
                your events, participants and registrations easily.
            </p>

            <ul class="login-features">
                <li>📅 Manage Events</li>
                <li>👥 Manage Participants</li>
                <li>📝 Manage Registrations</li>
                <li>⚡ Simple and Efficient Event Management</li>
            </ul>

        </div>


        <!-- Login Form -->
        <div class="login-form-section">

            <h2>Sign In</h2>

            <p class="login-subtitle">
                Enter your account details to continue.
            </p>

            <form asp-action="Login" method="post">

                @Html.AntiForgeryToken()

                @Html.ValidationSummary(
                    true,
                    "",
                    new { @class = "text-danger validation-summary" }
                )


                <!-- Email -->
                <div class="mb-3">

                    <label asp-for="Email" class="form-label">
                        Email Address
                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Enter your email" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>


                <!-- Password -->
                <div class="mb-4">

                    <label asp-for="Password" class="form-label">
                        Password
                    </label>

                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           placeholder="Enter your password" />

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>

                </div>


                <!-- Login -->
                <button type="submit"
                        class="login-button">
                    🔐 Login
                </button>


                <!-- Register -->
                <div class="register-section">

                    Don't have an account?

                    <a class="register-link"
                       asp-action="Register">
                        Create an account
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}