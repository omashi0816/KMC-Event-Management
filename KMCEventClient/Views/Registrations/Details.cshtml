@model KMCEventClient.Models.Registration

@{
    ViewData["Title"] = "Registration Details";
}

<style>
    .details-page {
        padding: 45px 0 60px;
    }

    .details-header {
        background: linear-gradient(135deg, #0d6efd, #6610f2);
        color: white;
        border-radius: 24px;
        padding: 40px;
        margin-bottom: 30px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.12);
    }

    .header-icon {
        font-size: 45px;
        margin-bottom: 10px;
    }

    .details-header h1 {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .details-header p {
        margin: 0;
        opacity: 0.9;
    }

    .details-card {
        max-width: 800px;
        margin: 0 auto;
        background: white;
        border-radius: 22px;
        padding: 35px;
        box-shadow: 0 8px 28px rgba(0,0,0,0.08);
    }

    .details-title {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .details-subtitle {
        color: #6c757d;
        margin-bottom: 28px;
    }

    .info-item {
        display: flex;
        align-items: center;
        padding: 18px 0;
        border-bottom: 1px solid #edf0f2;
    }

    .info-item:last-child {
        border-bottom: none;
    }

    .info-icon {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        background: #eef4ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin-right: 18px;
        flex-shrink: 0;
    }

    .info-content {
        flex: 1;
    }

    .info-label {
        display: block;
        font-size: 0.85rem;
        color: #6c757d;
        margin-bottom: 3px;
    }

    .info-value {
        font-size: 1.05rem;
        font-weight: 600;
        color: #212529;
    }

    .status-box {
        margin-top: 25px;
        padding: 16px 18px;
        border-radius: 15px;
        background: #eaf7ee;
        color: #198754;
        border: 1px solid #d1e7dd;
    }

    .action-buttons {
        margin-top: 30px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .back-btn {
        border-radius: 25px;
        padding: 10px 25px;
        font-weight: 600;
    }

    .cancel-btn {
        border-radius: 25px;
        padding: 10px 25px;
        font-weight: 600;
    }

    @@media (max-width: 768px) {
        .details-header {
            padding: 30px 25px;
        }

        .details-card {
            padding: 25px 20px;
        }

        .info-item {
            align-items: flex-start;
        }
    }
</style>


<div class="container details-page">

    <!-- Header -->
    <div class="details-header">

        <div class="header-icon">
            📋
        </div>

        <h1>Registration Details</h1>

        <p>
            View the details of this event registration.
        </p>

    </div>


    <!-- Details Card -->
    <div class="details-card">

        <h3 class="details-title">
            Registration Information
        </h3>

        <p class="details-subtitle">
            Information about the selected event registration.
        </p>


        <!-- Event -->
        <div class="info-item">

            <div class="info-icon">
                📅
            </div>

            <div class="info-content">

                <span class="info-label">
                    Event
                </span>

                <span class="info-value">
                    @(Model.Event?.Title ?? "Not available")
                </span>

            </div>

        </div>


        <!-- Participant -->
        <div class="info-item">

            <div class="info-icon">
                👤
            </div>

            <div class="info-content">

                <span class="info-label">
                    Participant
                </span>

                <span class="info-value">
                    @(Model.Participant?.FullName ?? "Not available")
                </span>

            </div>

        </div>


        <!-- Registration Date -->
        <div class="info-item">

            <div class="info-icon">
                🕒
            </div>

            <div class="info-content">

                <span class="info-label">
                    Registered At
                </span>

                <span class="info-value">
                    @Model.RegistrationDate.ToString("g")
                </span>

            </div>

        </div>


        <!-- Status -->
        <div class="status-box">
            ✓ <strong>Registration Active</strong>
            <br />
            <small>
                This registration is currently recorded in the system.
            </small>
        </div>


        <!-- Buttons -->
        <div class="action-buttons">

            <a class="btn btn-outline-secondary back-btn"
               asp-action="Index">
                ← Back to Registrations
            </a>

            <a class="btn btn-outline-danger cancel-btn"
               asp-action="Delete"
               asp-route-id="@Model.Id">
                🗑️ Cancel Registration
            </a>

        </div>

    </div>

</div>