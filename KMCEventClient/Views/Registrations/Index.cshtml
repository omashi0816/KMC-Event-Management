@model IEnumerable<KMCEventClient.Models.RegistrationViewModel>

@{
    ViewData["Title"] = "Registrations";
}

<style>
    .registrations-page {
        padding: 25px 0 50px;
    }

    .registrations-header {
        background: linear-gradient(135deg, #0d6efd, #6610f2);
        color: white;
        border-radius: 24px;
        padding: 45px 35px;
        margin-bottom: 35px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.12);
    }

    .registrations-header h1 {
        font-size: 2.6rem;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .registrations-header p {
        margin: 0;
        opacity: 0.9;
    }

    .register-btn {
        display: inline-block;
        background: white;
        color: #0d6efd;
        text-decoration: none;
        padding: 11px 22px;
        border-radius: 25px;
        font-weight: 600;
        transition: 0.3s;
        white-space: nowrap;
    }

    .register-btn:hover {
        color: #0d6efd;
        transform: translateY(-2px);
        box-shadow: 0 7px 18px rgba(0,0,0,0.15);
    }

    .registration-card {
        height: 100%;
        background: white;
        border-radius: 20px;
        overflow: hidden;
        border: none;
        box-shadow: 0 7px 25px rgba(0,0,0,0.08);
        transition: 0.3s ease;
    }

    .registration-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.13);
    }

    .registration-card-top {
        height: 7px;
        background: linear-gradient(90deg, #0d6efd, #6610f2);
    }

    .registration-card-body {
        padding: 25px;
    }

    .registration-icon {
        width: 60px;
        height: 60px;
        border-radius: 16px;
        background: #eef4ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin-bottom: 18px;
    }

    .registration-event {
        font-size: 1.25rem;
        font-weight: 700;
        color: #212529;
        margin-bottom: 15px;
        word-break: break-word;
    }

    .registration-info {
        color: #6c757d;
        margin-bottom: 10px;
        font-size: 0.95rem;
        word-break: break-word;
    }

    .registration-info strong {
        color: #343a40;
    }

    .registration-actions {
        margin-top: 22px;
    }

    .delete-btn {
        border-radius: 20px;
        padding: 7px 17px;
    }

    .empty-registrations {
        text-align: center;
        background: #f8f9fa;
        border-radius: 20px;
        padding: 60px 20px;
    }

    .empty-icon {
        font-size: 50px;
        margin-bottom: 15px;
    }

    .empty-registrations h3 {
        font-weight: 700;
    }

    @@media (max-width: 768px) {
        .registrations-header {
            padding: 35px 22px;
        }

        .registrations-header h1 {
            font-size: 2rem;
        }
    }
</style>


<div class="container registrations-page">

    <!-- Header -->
    <div class="registrations-header">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

            <div>
                <h1>📝 Registrations</h1>

                <p>
                    Manage event registrations and participants.
                </p>
            </div>

            <a class="register-btn"
               asp-action="Create">
                + Register Participant
            </a>

        </div>

    </div>


    <!-- Registration Cards -->
    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var r in Model)
            {
                <div class="col-lg-4 col-md-6">

                    <div class="registration-card">

                        <div class="registration-card-top"></div>

                        <div class="registration-card-body">

                            <div class="registration-icon">
                                📝
                            </div>

                            <div class="registration-event">
                                @r.EventTitle
                            </div>

                            <div class="registration-info">
                                👤 <strong>Participant:</strong>
                                @r.ParticipantName
                            </div>

                            <div class="registration-actions">

                                <form asp-action="Delete"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this registration?');">

                                    <input type="hidden"
                                           name="id"
                                           value="@r.Id" />

                                    <button type="submit"
                                            class="btn btn-outline-danger delete-btn">
                                        🗑️ Delete Registration
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="empty-registrations">

            <div class="empty-icon">
                📝
            </div>

            <h3>No Registrations Found</h3>

            <p class="text-muted">
                There are currently no event registrations.
            </p>

            <a asp-action="Create"
               class="btn btn-primary rounded-pill px-4">
                Register Participant
            </a>

        </div>
    }

</div>