@model ErrorViewModel

@{
    ViewData["Title"] = "Error";
}

<style>
    .error-page {
        min-height: 65vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 15px;
    }

    .error-card {
        max-width: 700px;
        width: 100%;
        background: #ffffff;
        border-radius: 24px;
        padding: 50px 35px;
        text-align: center;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.10);
    }

    .error-icon {
        width: 90px;
        height: 90px;
        margin: 0 auto 25px;
        border-radius: 50%;
        background: #fff0f0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 45px;
    }

    .error-card h1 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 15px;
        color: #dc3545;
    }

    .error-card h2 {
        font-size: 1.2rem;
        font-weight: 500;
        color: #555;
        margin-bottom: 25px;
    }

    .request-id {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 12px 18px;
        margin: 20px auto;
        max-width: 500px;
        color: #555;
    }

    .request-id code {
        color: #0d6efd;
    }

    .home-btn {
        display: inline-block;
        background: #0d6efd;
        color: white;
        padding: 12px 28px;
        border-radius: 28px;
        text-decoration: none;
        font-weight: 600;
        margin-top: 10px;
        transition: 0.3s;
    }

    .home-btn:hover {
        background: #0b5ed7;
        color: white;
        transform: translateY(-2px);
    }

    .development-info {
        margin-top: 30px;
        padding: 18px;
        background: #fff8e1;
        border-radius: 12px;
        text-align: left;
        font-size: 0.9rem;
        color: #665c3c;
    }

    @@media (max-width: 768px) {
        .error-card {
            padding: 40px 20px;
        }

        .error-card h1 {
            font-size: 2rem;
        }
    }
</style>

<div class="error-page">

    <div class="error-card">

        <div class="error-icon">
            ⚠️
        </div>

        <h1>Oops! Something went wrong.</h1>

        <h2>
            An unexpected error occurred while processing your request.
            Please try again later.
        </h2>

        @if (Model.ShowRequestId)
        {
            <div class="request-id">
                <strong>Request ID:</strong>
                <code>@Model.RequestId</code>
            </div>
        }

        <a asp-controller="Home"
           asp-action="Index"
           class="home-btn">
            ← Back to Home
        </a>

        @if (Model.ShowRequestId)
        {
            <div class="development-info">
                <strong>Development Information</strong>
                <p class="mb-0 mt-2">
                    The request ID above can help identify this error
                    during application debugging.
                </p>
            </div>
        }

    </div>

</div>