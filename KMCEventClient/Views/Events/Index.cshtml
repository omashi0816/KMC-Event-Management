@model IEnumerable<KMCEventClient.Models.Event>

@{
    ViewData["Title"] = "Events";

    var token = Context.Session.GetString("JwtToken");
    var currentUserId = ViewBag.CurrentUserId as int?;
    var currentUserRole = ViewBag.CurrentUserRole as string;

    bool isOrganizer =
        !string.IsNullOrWhiteSpace(token) &&
        string.Equals(currentUserRole, "Organizer", StringComparison.OrdinalIgnoreCase);
}

<style>
    .events-page {
        padding: 25px 0 50px;
    }

    .events-header {
        background: linear-gradient(135deg, #0d6efd, #6610f2);
        color: white;
        border-radius: 24px;
        padding: 45px 35px;
        margin-bottom: 35px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.12);
    }

    .events-header h1 {
        font-size: 2.6rem;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .events-header p {
        margin: 0;
        opacity: 0.9;
    }

    .create-event-btn {
        display: inline-block;
        background: white;
        color: #0d6efd;
        text-decoration: none;
        padding: 11px 22px;
        border-radius: 25px;
        font-weight: 600;
        transition: 0.3s;
        white-space: nowrap;
    }

    .create-event-btn:hover {
        color: #0d6efd;
        transform: translateY(-2px);
        box-shadow: 0 7px 18px rgba(0,0,0,0.15);
    }

    .event-card {
        height: 100%;
        background: white;
        border-radius: 20px;
        overflow: hidden;
        border: none;
        box-shadow: 0 7px 25px rgba(0,0,0,0.08);
        transition: 0.3s ease;
    }

    .event-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.13);
    }

    .event-card-top {
        height: 7px;
        background: linear-gradient(90deg, #0d6efd, #6610f2);
    }

    .event-card-body {
        padding: 25px;
    }

    .event-icon {
        width: 58px;
        height: 58px;
        border-radius: 15px;
        background: #eef4ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin-bottom: 18px;
    }

    .event-title {
        font-size: 1.35rem;
        font-weight: 700;
        color: #212529;
        margin-bottom: 18px;
        word-break: break-word;
    }

    .event-info {
        color: #6c757d;
        margin-bottom: 10px;
        font-size: 0.95rem;
    }

    .event-info strong {
        color: #343a40;
    }

    .event-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 22px;
    }

    .event-actions .btn {
        border-radius: 20px;
        padding: 7px 15px;
        font-size: 0.88rem;
    }

    .empty-events {
        text-align: center;
        background: #f8f9fa;
        border-radius: 20px;
        padding: 60px 20px;
    }

    .empty-icon {
        font-size: 50px;
        margin-bottom: 15px;
    }

    .empty-events h3 {
        font-weight: 700;
    }

    @@media (max-width: 768px) {
        .events-header {
            padding: 35px 22px;
        }

        .events-header h1 {
            font-size: 2rem;
        }

        .events-header .d-flex {
            align-items: flex-start !important;
        }
    }
</style>

<div class="container events-page">

    <!-- Header -->
    <div class="events-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

            <div>
                <h1>📅 Events</h1>
                <p>Discover and manage all available events.</p>
            </div>

            @if (isOrganizer)
            {
                <a class="create-event-btn"
                   asp-action="Create">
                    + Create New Event
                </a>
            }

        </div>
    </div>


    <!-- Event Cards -->
    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var ev in Model)
            {
                <div class="col-lg-4 col-md-6">

                    <div class="event-card">

                        <div class="event-card-top"></div>

                        <div class="event-card-body">

                            <div class="event-icon">
                                📅
                            </div>

                            <div class="event-title">
                                @ev.Title
                            </div>

                            <div class="event-info">
                                🗓️ <strong>Start:</strong>
                                @ev.StartDate.ToString("g")
                            </div>

                            <div class="event-info">
                                ⏰ <strong>End:</strong>
                                @(ev.EndDate?.ToString("g") ?? "Not specified")
                            </div>

                            <div class="event-info">
                                📍 <strong>Location:</strong>
                                @ev.Location
                            </div>

                            <div class="event-actions">

                                <a class="btn btn-primary"
                                   asp-action="Details"
                                   asp-route-id="@ev.Id">
                                    Details
                                </a>

                                @if (currentUserId.HasValue &&
                                     currentUserId.Value == ev.OrganizerId &&
                                     string.Equals(currentUserRole, "Organizer",
                                     StringComparison.OrdinalIgnoreCase))
                                {
                                    <a class="btn btn-outline-secondary"
                                       asp-action="Edit"
                                       asp-route-id="@ev.Id">
                                        Edit
                                    </a>

                                    <a class="btn btn-outline-danger"
                                       asp-action="Delete"
                                       asp-route-id="@ev.Id">
                                        Delete
                                    </a>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <!-- No Events -->
        <div class="empty-events">

            <div class="empty-icon">📅</div>

            <h3>No Events Available</h3>

            <p class="text-muted">
                There are currently no events available.
            </p>

            @if (isOrganizer)
            {
                <a asp-action="Create"
                   class="btn btn-primary rounded-pill px-4">
                    Create First Event
                </a>
            }

        </div>
    }

</div>