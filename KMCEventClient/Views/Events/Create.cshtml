@model KMCEventClient.Models.Event

@{
    ViewData["Title"] = "Create Event";
}

<style>
    .create-page {
        padding: 35px 0 50px;
    }

    .create-header {
        background: linear-gradient(135deg, #0d6efd, #6610f2);
        color: white;
        border-radius: 24px;
        padding: 35px 40px;
        margin-bottom: 30px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.12);
    }

    .create-header h1 {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .create-header p {
        margin: 0;
        opacity: 0.9;
    }

    .form-card {
        background: white;
        border-radius: 22px;
        padding: 35px;
        box-shadow: 0 8px 28px rgba(0,0,0,0.08);
    }

    .form-title {
        font-weight: 700;
        margin-bottom: 25px;
        color: #212529;
    }

    .form-label {
        font-weight: 600;
        color: #343a40;
        margin-bottom: 8px;
    }

    .form-control {
        border-radius: 12px;
        padding: 11px 14px;
        border: 1px solid #dee2e6;
        transition: 0.2s;
    }

    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13,110,253,0.12);
    }

    textarea.form-control {
        min-height: 130px;
        resize: vertical;
    }

    .form-section {
        margin-bottom: 22px;
    }

    .required-note {
        font-size: 0.85rem;
        color: #6c757d;
        margin-bottom: 25px;
    }

    .btn-create {
        background: linear-gradient(135deg, #0d6efd, #6610f2);
        color: white;
        border: none;
        border-radius: 25px;
        padding: 11px 28px;
        font-weight: 600;
        transition: 0.3s;
    }

    .btn-create:hover {
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(13,110,253,0.25);
    }

    .btn-back {
        border-radius: 25px;
        padding: 10px 24px;
        font-weight: 600;
    }

    .form-icon {
        font-size: 45px;
        margin-bottom: 10px;
    }

    @@media (max-width: 768px) {
        .create-header {
            padding: 30px 25px;
        }

        .form-card {
            padding: 25px 20px;
        }
    }
</style>


<div class="container create-page">

    <!-- Header -->
    <div class="create-header">

        <div class="form-icon">
            📅
        </div>

        <h1>Create New Event</h1>

        <p>
            Add a new event by entering the required event details below.
        </p>

    </div>


    <!-- Form Card -->
    <div class="form-card">

        <h3 class="form-title">
            Event Information
        </h3>

        <p class="required-note">
            Please provide accurate information about your event.
        </p>


        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            @Html.ValidationSummary(
                true,
                "",
                new { @class = "text-danger mb-3" }
            )


            <!-- Title -->
            <div class="form-section">

                <label asp-for="Title" class="form-label">
                    Event Title
                </label>

                <input asp-for="Title"
                       class="form-control"
                       placeholder="Enter event title" />

                <span asp-validation-for="Title"
                      class="text-danger">
                </span>

            </div>


            <!-- Start Date -->
            <div class="form-section">

                <label asp-for="StartDate" class="form-label">
                    Start Date & Time
                </label>

                <input asp-for="StartDate"
                       class="form-control"
                       type="datetime-local" />

                <span asp-validation-for="StartDate"
                      class="text-danger">
                </span>

            </div>


            <!-- End Date -->
            <div class="form-section">

                <label asp-for="EndDate" class="form-label">
                    End Date & Time
                </label>

                <input asp-for="EndDate"
                       class="form-control"
                       type="datetime-local" />

                <span asp-validation-for="EndDate"
                      class="text-danger">
                </span>

            </div>


            <!-- Location -->
            <div class="form-section">

                <label asp-for="Location" class="form-label">
                    Location
                </label>

                <input asp-for="Location"
                       class="form-control"
                       placeholder="Enter event location" />

            </div>


            <!-- Description -->
            <div class="form-section">

                <label asp-for="Description" class="form-label">
                    Description
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          placeholder="Enter event description"></textarea>

            </div>


            <!-- Buttons -->
            <div class="d-flex gap-2 mt-4">

                <button type="submit"
                        class="btn-create">
                    ✓ Create Event
                </button>

                <a class="btn btn-outline-secondary btn-back"
                   asp-action="Index">
                    ← Back to Events
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}