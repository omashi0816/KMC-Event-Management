@{
    ViewData["Title"] = "Privacy Policy";
}

<style>
    .privacy-page {
        padding: 40px 0 60px;
    }

    .privacy-header {
        background: linear-gradient(135deg, #0d6efd, #6610f2);
        color: white;
        border-radius: 24px;
        padding: 45px 35px;
        text-align: center;
        margin-bottom: 30px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.12);
    }

    .privacy-icon {
        font-size: 48px;
        margin-bottom: 12px;
    }

    .privacy-header h1 {
        font-weight: 700;
        margin-bottom: 10px;
    }

    .privacy-header p {
        margin: 0;
        opacity: 0.9;
    }

    .privacy-card {
        background: white;
        border: none;
        border-radius: 22px;
        box-shadow: 0 8px 28px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .privacy-content {
        padding: 40px;
    }

    .privacy-section {
        padding: 22px 0;
        border-bottom: 1px solid #edf0f5;
    }

    .privacy-section:first-child {
        padding-top: 0;
    }

    .privacy-section:last-child {
        border-bottom: none;
    }

    .privacy-section h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: #212529;
        margin-bottom: 12px;
    }

    .section-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 10px;
        background: #eef4ff;
        color: #0d6efd;
        font-size: 14px;
        font-weight: 700;
        margin-right: 8px;
    }

    .privacy-section p {
        color: #5f6368;
        line-height: 1.75;
    }

    .privacy-section ul {
        color: #5f6368;
        line-height: 2;
        padding-left: 25px;
    }

    .privacy-section li::marker {
        color: #0d6efd;
    }

    .privacy-note {
        border: none;
        border-radius: 15px;
        background: #eef6ff;
        color: #365a7d;
        padding: 18px 20px;
        margin-top: 25px;
    }

    .privacy-note strong {
        color: #0d6efd;
    }

    .last-updated {
        text-align: center;
        color: #6c757d;
        font-size: 0.9rem;
        margin-top: 25px;
    }

    @@media (max-width: 768px) {
        .privacy-header {
            padding: 35px 20px;
        }

        .privacy-content {
            padding: 25px 20px;
        }

        .privacy-header h1 {
            font-size: 2rem;
        }
    }
</style>


<div class="container privacy-page">

    <!-- Header -->
    <div class="privacy-header">

        <div class="privacy-icon">
            🔒
        </div>

        <h1>Privacy Policy</h1>

        <p>
            KMC Event Management System
        </p>

    </div>


    <!-- Privacy Content -->
    <div class="privacy-card">

        <div class="privacy-content">


            <!-- Section 1 -->
            <div class="privacy-section">

                <h3>
                    <span class="section-number">1</span>
                    Introduction
                </h3>

                <p>
                    Welcome to the KMC Event Management System. We respect
                    your privacy and are committed to protecting the personal
                    information provided when using our system.
                </p>

                <p>
                    This Privacy Policy explains how information is collected,
                    used, stored, and protected when users interact with the
                    KMC Event Management System.
                </p>

            </div>


            <!-- Section 2 -->
            <div class="privacy-section">

                <h3>
                    <span class="section-number">2</span>
                    Information We Collect
                </h3>

                <p>
                    The system may collect information required to manage
                    events, participants, registrations, and user accounts.
                </p>

                <ul>
                    <li>Name</li>
                    <li>Email address</li>
                    <li>Phone number</li>
                    <li>User account information</li>
                    <li>Event and registration information</li>
                </ul>

            </div>


            <!-- Section 3 -->
            <div class="privacy-section">

                <h3>
                    <span class="section-number">3</span>
                    How We Use Information
                </h3>

                <p>
                    The information collected through the system may be used
                    for the following purposes:
                </p>

                <ul>
                    <li>Creating and managing user accounts</li>
                    <li>Creating and managing events</li>
                    <li>Registering participants for events</li>
                    <li>Managing event registrations</li>
                    <li>Displaying relevant event and participant information</li>
                    <li>Improving the functionality of the event management system</li>
                </ul>

            </div>


            <!-- Section 4 -->
            <div class="privacy-section">

                <h3>
                    <span class="section-number">4</span>
                    Event Information
                </h3>

                <p>
                    Event information such as event title, date, time, type,
                    location, description, and capacity may be stored in the
                    system to support event management and registration
                    activities.
                </p>

            </div>


            <!-- Section 5 -->
            <div class="privacy-section">

                <h3>
                    <span class="section-number">5</span>
                    Participant Information
                </h3>

                <p>
                    Participant information is used to identify individuals
                    who register for events. Participant information may
                    include the participant's name, email address, and phone
                    number.
                </p>

                <p>
                    This information should only be provided when it is
                    necessary for participation and event registration
                    purposes.
                </p>

            </div>


            <!-- Section 6 -->
            <div class="privacy-section">

                <h3>
                    <span class="section-number">6</span>
                    Account Security
                </h3>

                <p>
                    Users are responsible for keeping their account credentials
                    confidential. Users should not share their passwords with
                    other individuals.
                </p>

                <p>
                    Appropriate security measures should be used to protect
                    information stored within the system from unauthorized
                    access.
                </p>

            </div>


            <!-- Section 7 -->
            <div class="privacy-section">

                <h3>
                    <span class="section-number">7</span>
                    Data Protection
                </h3>

                <p>
                    The KMC Event Management System is designed to restrict
                    access to protected functions according to user roles and
                    authentication requirements.
                </p>

                <p>
                    Access to event management and other restricted
                    functionality may require users to log in to the system.
                </p>

            </div>


            <!-- Section 8 -->
            <div class="privacy-section">

                <h3>
                    <span class="section-number">8</span>
                    Registration Information
                </h3>

                <p>
                    When a participant registers for an event, the system
                    stores the relationship between the selected event and
                    participant. This information is used to manage event
                    attendance and registration records.
                </p>

            </div>


            <!-- Section 9 -->
            <div class="privacy-section">

                <h3>
                    <span class="section-number">9</span>
                    Changes to This Privacy Policy
                </h3>

                <p>
                    This Privacy Policy may be updated when changes are made
                    to the KMC Event Management System or its
                    information-handling practices.
                </p>

            </div>


            <!-- Section 10 -->
            <div class="privacy-section">

                <h3>
                    <span class="section-number">10</span>
                    Contact
                </h3>

                <p>
                    If you have questions or concerns regarding this Privacy
                    Policy or the use of information within the system,
                    please contact the system administrator.
                </p>

            </div>


            <!-- Note -->
            <div class="privacy-note">

                <strong>🔒 Privacy Note:</strong>

                By using the KMC Event Management System, users acknowledge
                that the information they provide may be used for event
                management and registration purposes.

            </div>

        </div>

    </div>


    <div class="last-updated">
        KMC Event Management System • Privacy & Data Protection
    </div>

</div>